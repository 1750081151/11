<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>测测你是什么小动物 · 萌系人格小测试</title>
<meta name="description" content="24 个生活瞬间，8 个维度，16 种小动物。2 分钟测出你心里住着哪只毛茸茸。" />
<meta name="theme-color" content="#FFF3F5" />
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🐾</text></svg>" />
<style>
/* ============================================================
   萌系人格小测试 — 样式
   ============================================================ */

:root {
  --ink: #3B3743;
  --muted: #8A8496;
  --line: #EFE9F0;
  --pink: #FF8FA3;
  --pink-deep: #F2708A;
  --pink-soft: #FFF1F4;
  --blue: #7CB3F0;
  --blue-soft: #EEF5FF;
  --cream: #FFFBF7;
  --card: #FFFFFF;
  --shadow: 0 18px 48px rgba(122, 106, 140, 0.12);
  --shadow-sm: 0 6px 18px rgba(122, 106, 140, 0.10);
  --radius: 28px;
  --font: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
          "Microsoft YaHei", "Noto Sans SC", "Segoe UI", Roboto, sans-serif;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body { margin: 0; padding: 0; }

body {
  font-family: var(--font);
  color: var(--ink);
  background: linear-gradient(165deg, #FFF6F1 0%, #F3F7FF 45%, #FBF2FF 100%);
  background-attachment: fixed;
  min-height: 100vh;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 背景装饰 ---------- */
.bg-deco { position: fixed; inset: 0; pointer-events: none; overflow: hidden; z-index: 0; }
.bg-deco .paw, .bg-deco .blob { position: absolute; opacity: 0.5; }
.paw { font-size: 22px; filter: saturate(0.6); }
.p1 { top: 34%;  left: 3%;  transform: rotate(-18deg); }
.p2 { top: 26%; right: 8%; transform: rotate(22deg); }
.p3 { bottom: 18%; left: 10%; font-size: 18px; }
.p4 { bottom: 8%; right: 12%; transform: rotate(-40deg); }
.blob { border-radius: 50%; filter: blur(46px); opacity: 0.55; }
.b1 { width: 320px; height: 320px; background: #FFD9E1; top: -90px; right: -80px; }
.b2 { width: 280px; height: 280px; background: #D8E7FF; bottom: -100px; left: -70px; }

/* ---------- 布局 ---------- */
.app {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 700px;
  margin: 0 auto;
  padding: 44px 20px 48px;
}

.screen { display: none; animation: fadeUp 0.42s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
.screen.is-active { display: block; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ---------- 开场 ---------- */
.eyebrow {
  margin: 0 0 18px;
  font-size: 13px;
  letter-spacing: 0.14em;
  color: var(--muted);
}

.title {
  margin: 0 0 16px;
  font-size: 46px;
  line-height: 1.28;
  letter-spacing: -0.01em;
  font-weight: 800;
}

.title .hl {
  background: linear-gradient(100deg, #FF8FA3 10%, #F2708A 40%, #9B8CF0 95%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.lead {
  margin: 0 0 8px;
  font-size: 15.5px;
  color: #6E6879;
}

.avatar-row {
  display: flex;
  justify-content: center;
  align-items: flex-end;
  gap: 4px;
  margin: 18px 0 26px;
}
.avatar-row svg { filter: drop-shadow(0 10px 18px rgba(120, 100, 140, 0.16)); }
.avatar-row svg:nth-child(1) { transform: rotate(-7deg); }
.avatar-row svg:nth-child(2) { transform: translateY(-10px) scale(1.1); }
.avatar-row svg:nth-child(3) { transform: rotate(7deg); }

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 15px 30px;
  border: none;
  border-radius: 999px;
  font-family: inherit;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.16s ease, box-shadow 0.16s ease, background 0.16s ease;
}

.btn-primary {
  width: 100%;
  color: #fff;
  background: linear-gradient(120deg, #FF9AAC, #F2708A 55%, #E86A93);
  box-shadow: 0 12px 26px rgba(242, 112, 138, 0.34);
}
.btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 32px rgba(242, 112, 138, 0.42); }
.btn-primary:active { transform: translateY(0); }
.btn-primary .arrow { transition: transform 0.16s ease; }
.btn-primary:hover .arrow { transform: translateX(4px); }

.btn-ghost {
  flex: 1;
  color: #5E5870;
  background: #F7F4F9;
  box-shadow: none;
}
.btn-ghost:hover { background: #F0EBF4; transform: translateY(-1px); }

.link-btn {
  border: none;
  background: transparent;
  padding: 4px 2px;
  font-family: inherit;
  font-size: 14px;
  color: var(--muted);
  cursor: pointer;
}
.link-btn:hover { color: var(--pink-deep); }

.meta {
  margin: 16px 0 0;
  font-size: 13px;
  color: var(--muted);
  text-align: center;
}
.meta.small { margin-top: 6px; font-size: 12.5px; opacity: 0.85; }

/* ---------- 答题 ---------- */
.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.step { font-size: 13px; color: var(--muted); letter-spacing: 0.08em; }

.progress {
  height: 6px;
  border-radius: 99px;
  background: #EFE9F1;
  overflow: hidden;
}
.progress span {
  display: block;
  height: 100%;
  width: 0;
  border-radius: 99px;
  background: linear-gradient(90deg, #FFB4C1, #F2708A);
  transition: width 0.35s cubic-bezier(0.3, 0.9, 0.3, 1);
}

.q-card {
  position: relative;
  margin-top: 26px;
  padding: 30px 26px 26px;
  background: var(--card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
}

.q-index {
  position: absolute;
  top: 18px;
  right: 26px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.12em;
  color: #DED6E4;
}

.q-text {
  margin: 0 0 22px;
  padding-right: 34px;
  font-size: 21px;
  line-height: 1.55;
  font-weight: 700;
  letter-spacing: 0.01em;
}

.options { display: flex; flex-direction: column; gap: 11px; }
.options.anim-in { animation: fadeUp 0.3s ease both; }

.option {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  width: 100%;
  padding: 15px 17px;
  text-align: left;
  font-family: inherit;
  font-size: 15.5px;
  line-height: 1.6;
  color: #4A4458;
  background: #FBF8FB;
  border: 2px solid transparent;
  border-radius: 18px;
  cursor: pointer;
  transition: transform 0.14s ease, background 0.14s ease, border-color 0.14s ease, box-shadow 0.14s ease;
}

.option:hover {
  background: var(--pink-soft);
  border-color: #FFC9D4;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(242, 112, 138, 0.12);
}

.option.is-picked {
  background: var(--pink-soft);
  border-color: var(--pink);
  transform: scale(0.995);
}

.option-key {
  flex: 0 0 26px;
  height: 26px;
  margin-top: 2px;
  border-radius: 9px;
  background: #F1EBF4;
  color: #9A93A6;
  font-size: 12.5px;
  font-weight: 800;
  line-height: 26px;
  text-align: center;
  transition: background 0.14s ease, color 0.14s ease;
}
.option:hover .option-key,
.option.is-picked .option-key { background: var(--pink); color: #fff; }

.kbd-hint {
  margin: 18px 0 0;
  font-size: 12.5px;
  color: #A9A2B4;
  text-align: center;
}
kbd {
  display: inline-block;
  min-width: 20px;
  padding: 1px 5px;
  margin: 0 1px;
  border-radius: 6px;
  background: #F2EDF5;
  border-bottom: 2px solid #E3DAE8;
  font-family: var(--font);
  font-size: 11.5px;
  color: #7C7488;
}

/* ---------- 结果 ---------- */
.result-card {
  position: relative;
  padding: 28px 26px 26px;
  background: var(--card);
  border-radius: 32px;
  box-shadow: var(--shadow);
}
.link-btn.home { position: absolute; top: 16px; left: 22px; }

.shared-note {
  margin: 22px 0 6px;
  padding: 9px 14px;
  border-radius: 12px;
  background: var(--blue-soft);
  color: #5B7FB5;
  font-size: 13px;
  text-align: center;
}

.result-head {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 22px;
}

.result-avatar {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  width: 176px;
  height: 176px;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #FFF4F6, #FFE6EC 62%, #FFDCE6);
  box-shadow: inset 0 0 0 6px rgba(255, 255, 255, 0.7);
}
.result-avatar svg { animation: bob 3.2s ease-in-out infinite; }
@keyframes bob {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

.result-id { min-width: 0; }
.result-kicker { margin: 0 0 2px; font-size: 12.5px; color: var(--muted); letter-spacing: 0.08em; }
#result-name { margin: 0; font-size: 32px; font-weight: 800; line-height: 1.3; }
.result-title {
  margin: 2px 0 8px;
  font-size: 16px;
  font-weight: 700;
  color: var(--pink-deep);
}
.result-tag { margin: 0; font-size: 13px; color: var(--muted); }

.quote {
  margin: 22px 0 12px;
  padding: 16px 18px;
  border-left: 4px solid #FFC9D4;
  border-radius: 0 14px 14px 0;
  background: #FFFAFB;
  font-size: 15.5px;
  color: #5B5468;
}

.desc { margin: 0 0 6px; font-size: 15px; color: #5B5468; }

.section-h {
  margin: 26px 0 12px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #9A93A6;
}
.section-h::before { content: "✦ "; color: #FFC0CC; }

.bars { display: flex; flex-direction: column; gap: 9px; }
.bar-row { display: grid; grid-template-columns: 46px 1fr 34px; align-items: center; gap: 10px; }
.bar-name { font-size: 13px; color: #6E6879; }
.bar-track { height: 10px; border-radius: 99px; background: #F4EFF6; overflow: hidden; }
.bar-fill {
  display: block;
  height: 100%;
  border-radius: 99px;
  transition: width 0.7s cubic-bezier(0.2, 0.9, 0.2, 1);
}
.bar-val { font-size: 12.5px; color: #A9A2B4; text-align: right; font-variant-numeric: tabular-nums; }

.second {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 14px 0 0;
  padding: 10px 14px;
  border-radius: 14px;
  background: #FBF9FC;
  font-size: 13.5px;
  color: #6E6879;
}
.second b { color: #4A4458; }
.second-avatar { flex: 0 0 auto; line-height: 0; }

.points { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
.points li {
  padding: 7px 13px;
  border-radius: 999px;
  background: var(--pink-soft);
  color: #C25E75;
  font-size: 13px;
  font-weight: 600;
}

.match { display: flex; flex-direction: column; gap: 10px; }
.match-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  border-radius: 16px;
  background: #FBF9FC;
}
.match-label {
  flex: 0 0 auto;
  padding: 3px 9px;
  border-radius: 8px;
  font-size: 11.5px;
  font-weight: 700;
}
.match-label.good { background: #E8F7EE; color: #3E9B6C; }
.match-label.clash { background: #FFF1E8; color: #C47438; }
.match-avatar { line-height: 0; }
.match-name { font-size: 14px; font-weight: 700; }
.match-name em { margin-left: 6px; font-style: normal; font-weight: 500; font-size: 12.5px; color: var(--muted); }

.tip-box {
  margin-top: 22px;
  padding: 16px 18px;
  border-radius: 18px;
  background: linear-gradient(135deg, #F2F8FF, #F7F2FF);
  font-size: 14px;
  color: #5B5468;
}
.tip-box b { display: block; margin-bottom: 4px; font-size: 12.5px; letter-spacing: 0.1em; color: #7E8FB5; }

.result-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
.result-actions .btn-primary { flex: 1 1 100%; }

/* ---------- 图鉴 ---------- */
.gallery-head { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
.gallery-title { margin: 0; font-size: 24px; font-weight: 800; }
.gallery-sub { margin: 0 0 18px; font-size: 13.5px; color: var(--muted); }

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));
  gap: 12px;
}

.gallery-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  padding: 12px 6px 14px;
  background: #fff;
  border: 2px solid transparent;
  border-radius: 22px;
  box-shadow: var(--shadow-sm);
  font-family: inherit;
  cursor: pointer;
  transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
}
.gallery-item:hover {
  transform: translateY(-3px);
  border-color: #FFD3DC;
  box-shadow: 0 12px 26px rgba(122, 106, 140, 0.16);
}
.gallery-avatar { line-height: 0; }
.gallery-name { font-size: 14px; font-weight: 800; color: var(--ink); }
.gallery-title { font-size: 11.5px; color: var(--muted); }

/* ---------- 其它 ---------- */
.foot {
  margin-top: 34px;
  font-size: 11.5px;
  color: #B0A9BB;
  text-align: center;
  line-height: 1.8;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 28px;
  transform: translate(-50%, 20px);
  max-width: 90vw;
  padding: 12px 20px;
  border-radius: 999px;
  background: rgba(59, 55, 67, 0.94);
  color: #fff;
  font-size: 13.5px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease, transform 0.25s ease;
  z-index: 40;
}
.toast.is-on { opacity: 1; transform: translate(-50%, 0); }

/* ---------- 小屏 ---------- */
@media (max-width: 560px) {
  .app { padding: 30px 16px 40px; }
  .title { font-size: 34px; }
  .q-card { padding: 24px 18px 20px; border-radius: 24px; }
  .q-text { font-size: 18.5px; }
  .option { font-size: 14.5px; padding: 13px 14px; }
  .result-card { padding: 24px 18px 20px; border-radius: 26px; }
  .result-head { flex-direction: column; text-align: center; gap: 12px; }
  .result-avatar { width: 148px; height: 148px; }
  #result-name { font-size: 28px; }
  .match-item { flex-wrap: wrap; }
  .gallery-grid { grid-template-columns: repeat(3, 1fr); }
  .bar-row { grid-template-columns: 42px 1fr 30px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation: none !important; transition: none !important; }
}

</style>
</head>
<body>
<div class="bg-deco" aria-hidden="true">
  <span class="paw p1">🐾</span><span class="paw p2">🐾</span>
  <span class="paw p3">✨</span><span class="paw p4">🐾</span>
  <span class="blob b1"></span><span class="blob b2"></span>
</div>

<main class="app">

  <!-- ============ 开场 ============ -->
  <section class="screen" id="screen-intro">
    <p class="eyebrow">🐾 萌系人格小测试</p>
    <h1 class="title">测测你是<br /><span class="hl">什么小动物</span></h1>
    <p class="lead">24 个生活里的瞬间，8 个维度，16 只毛茸茸。<br />选最像你的那个，别想太久。</p>

    <div class="avatar-row" id="intro-avatars"></div>

    <button class="btn btn-primary" id="btn-start" type="button">开始测试 <span class="arrow">→</span></button>

    <p class="meta">24 题 · 每题 4 个选项 · 约 2 分钟</p>
    <p class="meta small" id="intro-count"></p>
  </section>

  <!-- ============ 答题 ============ -->
  <section class="screen" id="screen-quiz">
    <div class="quiz-head">
      <button class="link-btn" id="btn-back" type="button">← 返回</button>
      <span class="step" id="q-step">1 / 24</span>
    </div>
    <div class="progress" aria-hidden="true"><span id="q-bar-fill"></span></div>

    <div class="q-card">
      <span class="q-index" id="q-index">01</span>
      <h2 class="q-text" id="q-text"></h2>
      <div class="options" id="q-options"></div>
    </div>

    <p class="kbd-hint">键盘 <kbd>1</kbd>–<kbd>4</kbd> 快速选择 · <kbd>←</kbd> 回上一题</p>
  </section>

  <!-- ============ 结果 ============ -->
  <section class="screen" id="screen-result">
    <div class="result-card">
      <button class="link-btn home" id="btn-result-home" type="button">← 首页</button>
      <p class="shared-note" id="result-shared-note" hidden>🎁 这是朋友分享给你的结果</p>

      <div class="result-head">
        <div class="result-avatar" id="result-avatar"></div>
        <div class="result-id">
          <p class="result-kicker">你的小动物是</p>
          <h2 id="result-name"></h2>
          <p class="result-title" id="result-title"></p>
          <p class="result-tag" id="result-tag"></p>
        </div>
      </div>

      <blockquote class="quote" id="result-quote"></blockquote>
      <p class="desc" id="result-desc"></p>

      <h3 class="section-h">你的八维</h3>
      <div class="bars" id="result-bars"></div>
      <p class="second" id="result-second"></p>

      <h3 class="section-h">你的萌点</h3>
      <ul class="points" id="result-points"></ul>

      <h3 class="section-h">相性</h3>
      <div class="match" id="result-match"></div>

      <div class="tip-box">
        <b>养成建议</b>
        <span id="result-tip"></span>
      </div>

      <div class="result-actions">
        <button class="btn btn-primary" id="btn-again" type="button"><span id="result-again-label">再测一次</span></button>
        <button class="btn btn-ghost" id="btn-share" type="button">分享给朋友</button>
        <button class="btn btn-ghost" id="btn-gallery" type="button">小动物图鉴</button>
      </div>
    </div>
  </section>

  <!-- ============ 图鉴 ============ -->
  <section class="screen" id="screen-gallery">
    <div class="gallery-head">
      <button class="link-btn" id="btn-gallery-back" type="button">← 返回</button>
      <h2 class="gallery-title">小动物图鉴</h2>
    </div>
    <p class="gallery-sub">共 16 只，点一只看看它长什么样</p>
    <div class="gallery-grid" id="gallery-grid"></div>
  </section>

  <footer class="foot">
    灵感来自「测测你是什么小猫」· 本页为独立改作，结果仅供娱乐 🌙
  </footer>
</main>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
/* ============================================================
   萌系人格小测试 — 手绘风 SVG 小动物
   全部由参数生成，无外部图片依赖
   ============================================================ */

function _mirror(svg) {
  return `${svg}<g transform="translate(200 0) scale(-1 1)">${svg}</g>`;
}

function _ears(v) {
  const B = v.body, I = v.inner, L = v.line;
  switch (v.ear) {
    case 'cat':
      return _mirror(`<path d="M58 84 L64 26 Q66 19 72 24 L98 62 Z" fill="${B}" stroke="${L}" stroke-width="3" stroke-linejoin="round"/>
        <path d="M67 74 L71 39 Q72 35 75 38 L89 59 Z" fill="${I}"/>`);
    case 'fox':
      return _mirror(`<path d="M56 86 L57 16 Q58 9 64 14 L98 62 Z" fill="${B}" stroke="${L}" stroke-width="3" stroke-linejoin="round"/>
        <path d="M65 74 L66 33 Q66 29 70 32 L88 59 Z" fill="${I}"/>`);
    case 'dog':
      return _mirror(`<ellipse cx="50" cy="102" rx="17" ry="35" transform="rotate(16 50 102)" fill="${B}" stroke="${L}" stroke-width="3"/>
        <ellipse cx="52" cy="104" rx="9" ry="24" transform="rotate(16 52 104)" fill="${I}"/>`);
    case 'rabbit':
      return _mirror(`<ellipse cx="73" cy="44" rx="14" ry="33" transform="rotate(-9 73 44)" fill="${B}" stroke="${L}" stroke-width="3"/>
        <ellipse cx="73" cy="46" rx="7" ry="24" transform="rotate(-9 73 46)" fill="${I}"/>`);
    case 'hamster':
      return _mirror(`<circle cx="62" cy="60" r="16" fill="${B}" stroke="${L}" stroke-width="3"/>
        <circle cx="62" cy="60" r="8.5" fill="${I}"/>`);
    case 'round':
      return _mirror(`<circle cx="60" cy="66" r="11" fill="${B}" stroke="${L}" stroke-width="3"/>
        <circle cx="60" cy="66" r="5.5" fill="${I}"/>`);
    case 'owl':
      return _mirror(`<path d="M60 66 L52 34 Q51 27 58 31 L82 52 Z" fill="${B}" stroke="${L}" stroke-width="3" stroke-linejoin="round"/>`);
    case 'deer':
