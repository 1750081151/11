<script>
/* ============================================================
   萌系人格小测试 — 逻辑与界面
   ============================================================ */

(function () {
  'use strict';

  const $ = (sel, root) => (root || document).querySelector(sel);
  const $$ = (sel, root) => Array.from((root || document).querySelectorAll(sel));

  const STORE_COUNT = 'moe-test-count';
  const STORE_LAST = 'moe-test-last';

  const state = {
    idx: 0,
    answers: [],
    z: null,          // 8 维标准化向量
    pct: null,        // 8 维展示分（0–100）
    result: null,
    second: null,
    shared: false,
  };

  /* ---------------- 维度统计量 ----------------
     把每题各选项的权重看作均匀随机，按题目独立累加，
     得到每个维度的均值与标准差，用于标准化。 */
  const STATS = (function () {
    const s = {};
    DIMS.forEach((d) => { s[d.key] = { mu: 0, sd: 1 }; });
    QUESTIONS.forEach((q) => {
      DIMS.forEach((d) => {
        const vals = q.opts.map((o) => o.w[d.key] || 0);
        const n = vals.length;
        const mu = vals.reduce((a, b) => a + b, 0) / n;
        const va = vals.reduce((a, b) => a + (b - mu) * (b - mu), 0) / n;
        s[d.key].mu += mu;
        s[d.key].sd += va;   // 先累加方差，最后开方
      });
    });
    DIMS.forEach((d) => {
      s[d.key].sd = Math.sqrt(s[d.key].sd) || 1;
    });
    return s;
  })();

  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  // 展示分与 z 值之间的换算：pct = 50 + SCALE * z
  const SCALE = 14;

  function rawScores(answers) {
    const raw = {};
    DIMS.forEach((d) => { raw[d.key] = 0; });
    answers.forEach((choice, qi) => {
      const w = QUESTIONS[qi].opts[choice].w;
      Object.keys(w).forEach((k) => { raw[k] = (raw[k] || 0) + w[k]; });
    });
    return raw;
  }

  function zOf(raw) {
    const z = {};
    DIMS.forEach((d) => {
      z[d.key] = (raw[d.key] - STATS[d.key].mu) / STATS[d.key].sd;
    });
    return z;
  }

  function pctOf(z) {
    const p = {};
    DIMS.forEach((d) => {
      p[d.key] = clamp(Math.round(50 + SCALE * z[d.key]), 2, 98);
    });
    return p;
  }

  // 结果页的目标向量本身就用 0–100 的展示分表示
  function zOfTarget(t) {
    const z = {};
    DIMS.forEach((d) => { z[d.key] = (t[d.key] - 50) / SCALE; });
    return z;
  }

  /* ---------------- 匹配 ----------------
     用标准化向量的方向做余弦匹配：比谁更"像"而不是比谁更"强"，
     这样 16 种结果的分布才不会被居中类型吃掉。 */
  const ARCH = ANIMALS.map((a) => {
    const z = zOfTarget(a.target);
    let norm = 0;
    DIMS.forEach((d) => { norm += z[d.key] * z[d.key]; });
    return { animal: a, z, norm: Math.sqrt(norm) || 1 };
  });

  function rankAnimals(z) {
    let un = 0;
    DIMS.forEach((d) => { un += z[d.key] * z[d.key]; });
    un = Math.sqrt(un);

    return ARCH.map((x) => {
      let dot = 0;
      DIMS.forEach((d) => { dot += z[d.key] * x.z[d.key]; });
      // 方向余弦为主；向量几乎为零时退化为欧氏距离
      const cos = un < 1e-6 ? 0 : dot / (un * x.norm);
      const euclid = Math.sqrt(DIMS.reduce((acc, d) => acc + (z[d.key] - x.z[d.key]) ** 2, 0));
      return { animal: x.animal, sim: cos, dist: euclid };
    }).sort((p, q) => (q.sim - p.sim) || (p.dist - q.dist));
  }

  /* ---------------- 本地存储 ---------------- */

  function getCount() {
    const n = parseInt(localStorage.getItem(STORE_COUNT) || '0', 10);
    return Number.isFinite(n) ? n : 0;
  }
  function bumpCount() {
    const n = getCount() + 1;
    localStorage.setItem(STORE_COUNT, String(n));
    return n;
  }

  /* ---------------- 视图切换 ---------------- */

  function show(id) {
    $$('.screen').forEach((s) => s.classList.toggle('is-active', s.id === id));
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  /* ---------------- 开场 ---------------- */

  function renderIntro() {
    $('#intro-avatars').innerHTML = ['orange', 'rabbit', 'otter']
      .map((id) => avatarSVG(ANIMALS.find((x) => x.id === id), 96))
      .join('');

    const n = getCount();
    $('#intro-count').textContent = n > 0
      ? `这台设备已经测过 ${n} 次啦`
      : '还没有人在这台设备上测过，你可以是第一个';
    show('screen-intro');
  }

  /* ---------------- 答题 ---------------- */

  function renderQuestion() {
    const q = QUESTIONS[state.idx];
    const total = QUESTIONS.length;

    $('#q-step').textContent = `${state.idx + 1} / ${total}`;
    $('#q-bar-fill').style.width = `${((state.idx + 1) / total) * 100}%`;
    $('#q-text').textContent = q.q;
    $('#q-index').textContent = String(state.idx + 1).padStart(2, '0');

    const box = $('#q-options');
    box.innerHTML = '';
    box.classList.remove('anim-in');
    void box.offsetWidth;
    box.classList.add('anim-in');

    q.opts.forEach((opt, i) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'option';
      btn.innerHTML = `<span class="option-key">${'ABCD'[i]}</span><span class="option-text">${opt.t}</span>`;
      btn.addEventListener('click', () => choose(i));
      box.appendChild(btn);
    });

    show('screen-quiz');
  }

  let locked = false;
  function choose(i) {
    if (locked) return;
    locked = true;

    const btn = $$('#q-options .option')[i];
    if (btn) btn.classList.add('is-picked');

    state.answers[state.idx] = i;

    setTimeout(() => {
      locked = false;
      if (state.idx < QUESTIONS.length - 1) {
        state.idx += 1;
        renderQuestion();
      } else {
        finish();
      }
    }, 190);
  }

  function goBack() {
    if (state.idx === 0) { renderIntro(); return; }
    state.idx -= 1;
    renderQuestion();
  }

  /* ---------------- 结果 ------------- */

  function finish() {
    state.shared = false;
    const raw = rawScores(state.answers);
    state.z = zOf(raw);
    state.pct = pctOf(state.z);

    const ranked = rankAnimals(state.z);
    state.result = ranked[0].animal;
    state.second = ranked[1].animal;

    bumpCount();
    localStorage.setItem(STORE_LAST, state.result.id);
    renderResult();
  }

  function previewAnimal(a) {
    // 只读预览：直接用该动物的目标向量
    state.z = zOfTarget(a.target);
    state.pct = Object.assign({}, a.target);
    state.result = a;
    state.shared = false;
    state.second = rankAnimals(state.z).filter((r) => r.animal.id !== a.id)[0].animal;
    renderResult();
  }

  function renderResult() {
    const a = state.result;
    const p = state.pct;

    $('#result-avatar').innerHTML = avatarSVG(a, 168);
    $('#result-name').textContent = a.name;
    $('#result-title').textContent = a.title;
    $('#result-tag').textContent = a.tag;
    $('#result-desc').textContent = a.desc;
    $('#result-quote').textContent = '「' + a.quote + '」';
    $('#result-tip').textContent = a.tip;
    $('#result-points').innerHTML = a.points.map((x) => `<li>${x}</li>`).join('');

    $('#result-bars').innerHTML = DIMS.map((d) => `
      <div class="bar-row">
        <span class="bar-name">${d.name}</span>
        <span class="bar-track"><span class="bar-fill" style="width:${p[d.key]}%;background:${d.color}"></span></span>
        <span class="bar-val">${p[d.key]}</span>
      </div>`).join('');

    const good = ANIMALS.find((x) => x.id === a.good);
    const clash = ANIMALS.find((x) => x.id === a.clash);
    $('#result-match').innerHTML = `
      <div class="match-item">
        <span class="match-label good">很合拍</span>
        <span class="match-avatar">${avatarSVG(good, 54)}</span>
        <span class="match-name">${good.name}<em>${good.title}</em></span>
      </div>
      <div class="match-item">
        <span class="match-label clash">需磨合</span>
        <span class="match-avatar">${avatarSVG(clash, 54)}</span>
        <span class="match-name">${clash.name}<em>${clash.title}</em></span>
      </div>`;

    const sec = state.second;
    const secZ = zOfTarget(sec.target);
    let un = 0, sn = 0, dot = 0;
    DIMS.forEach((d) => {
      un += state.z[d.key] ** 2;
      sn += secZ[d.key] ** 2;
      dot += state.z[d.key] * secZ[d.key];
    });
    const sim = Math.round(50 + 50 * (dot / (Math.sqrt(un * sn) || 1)));
    $('#result-second').innerHTML = `
      <span class="second-avatar">${avatarSVG(sec, 46)}</span>
      <span>你也有 <b>${sec.name}（${sec.title}）</b> 的一面，相似度约 ${clamp(sim, 30, 95)}%</span>`;

    $('#result-shared-note').hidden = !state.shared;
    $('#result-again-label').textContent = state.shared ? '我也来测一次' : '再测一次';

    show('screen-result');
  }

  /* ---------------- 图鉴 ---------------- */

  function renderGallery() {
    $('#gallery-grid').innerHTML = ANIMALS.map((a) => `
      <button class="gallery-item" data-id="${a.id}" type="button">
        <span class="gallery-avatar">${avatarSVG(a, 104)}</span>
        <span class="gallery-name">${a.name}</span>
        <span class="gallery-title">${a.title}</span>
      </button>`).join('');

    $$('#gallery-grid .gallery-item').forEach((el) => {
      el.addEventListener('click', () => previewAnimal(ANIMALS.find((x) => x.id === el.dataset.id)));
    });

    show('screen-gallery');
  }

  /* ---------------- 分享 ---------------- */

  function share() {
    const base = location.href.split('#')[0];
    const url = `${base}#r=${state.result.id}`;
    const text = `我测出来是「${state.result.name}·${state.result.title}」，你是什么小动物？`;

    if (navigator.share) {
      navigator.share({ title: '萌系人格小测试', text, url }).catch(() => {});
      return;
    }
    const fallback = () => toast('复制这个链接发给朋友：' + url);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(`${text} ${url}`)
        .then(() => toast('链接已复制，发给朋友就能看到你的结果'))
        .catch(fallback);
    } else {
      fallback();
    }
  }

  let toastTimer = null;
  function toast(msg) {
    const el = $('#toast');
    el.textContent = msg;
    el.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('is-on'), 2800);
  }

  function readHash() {
    const m = /#r=([a-z-]+)/.exec(location.hash);
    if (!m) return false;
    const a = ANIMALS.find((x) => x.id === m[1]);
    if (!a) return false;

    state.z = zOfTarget(a.target);
    state.pct = Object.assign({}, a.target);
    state.result = a;
    state.second = rankAnimals(state.z).filter((r) => r.animal.id !== a.id)[0].animal;
    state.shared = true;
    renderResult();
    return true;
  }

  /* ---------------- 事件绑定 ---------------- */

  function bind() {
    $('#btn-start').addEventListener('click', () => {
      state.idx = 0;
      state.answers = [];
      renderQuestion();
    });
    $('#btn-back').addEventListener('click', goBack);
    $('#btn-result-home').addEventListener('click', () => {
      if (location.hash) history.replaceState(null, '', location.pathname);
      renderIntro();
    });
    $('#btn-again').addEventListener('click', () => {
      state.idx = 0;
      state.answers = [];
      renderQuestion();
    });
    $('#btn-gallery').addEventListener('click', renderGallery);
    $('#btn-gallery-back').addEventListener('click', () => {
      if (state.result && state.answers.length === QUESTIONS.length) renderResult();
      else renderIntro();
    });
    $('#btn-share').addEventListener('click', share);

    document.addEventListener('keydown', (e) => {
      if (!$('#screen-quiz').classList.contains('is-active')) return;
      if (['1', '2', '3', '4'].includes(e.key)) choose(Number(e.key) - 1);
      if (e.key === 'ArrowLeft') goBack();
    });
  }

  /* ---------------- 启动 ---------------- */

  document.addEventListener('DOMContentLoaded', () => {
    bind();
    if (!readHash()) renderIntro();
  });
})();

</script>
</body>
</html>
