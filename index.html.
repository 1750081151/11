 * @param {object} a 动物数据（含 av 配置与 id）
 * @param {number} size 显示尺寸（px）
 */
function avatarSVG(a, size = 160) {
  const v = a.av;
  const B = v.body, I = v.inner, L = v.line, C = v.cheek || '#FFB3C1';
  const clipId = `clip-${a.id}`;

  const whiskers = v.whisker
    ? `${_mirror(`<path d="M40 112 h18 M40 121 h18 M40 130 h18" stroke="${L}" stroke-width="2.6" opacity=".65" stroke-linecap="round"/>`)}`
    : '';

  const patch = v.patch
    ? `<g clip-path="url(#${clipId})">
        <path d="M52 104 a26 26 0 0 1 26 -30 l4 30 z" fill="#E9A96B" opacity=".85"/>
        <path d="M126 74 a22 22 0 0 1 21 26 l-26 -6 z" fill="#9C8C7C" opacity=".5"/></g>`
    : '';

  const stripe = v.stripe
    ? `<g clip-path="url(#${clipId})" stroke="${L}" stroke-width="4" opacity=".5" stroke-linecap="round" fill="none">
        <path d="M80 62 q5 -10 13 -5"/><path d="M98 58 q4 -10 13 -6"/><path d="M116 62 q5 -9 12 -4"/></g>`
    : '';

  const faceWhite = v.face === 'white'
    ? `<ellipse cx="100" cy="113" rx="43" ry="41" fill="#FFFDF8"/>`
    : '';

  const discs = v.face === 'disc'
    ? `<circle cx="76" cy="102" r="27" fill="${I}"/><circle cx="124" cy="102" r="27" fill="${I}"/>`
    : '';

  const flippers = v.face === 'seal'
    ? `<ellipse cx="46" cy="150" rx="16" ry="11" transform="rotate(-22 46 150)" fill="${B}" stroke="${L}" stroke-width="3"/>
       ${_mirror(`<ellipse cx="46" cy="150" rx="16" ry="11" transform="rotate(-22 46 150)" fill="${B}" stroke="${L}" stroke-width="3"/>`)}`
    : '';

  const nose = ['cat', 'fox', 'dog', 'hamster', 'round'].includes(v.ear)
    ? `<path d="M95 114 h10 q1.5 5 -5 6.5 q-6.5 -1.5 -5 -6.5 z" fill="#7A5C55"/>`
    : (v.ear === 'rabbit' ? `<ellipse cx="100" cy="116" rx="4.5" ry="3.4" fill="#F19CAB"/>` : '');

  const cheeks = _mirror(
    `<ellipse cx="65" cy="120" rx="11.5" ry="6.8" fill="${C}" opacity="${v.face === 'white' ? '.5' : '.6'}"/>`
  );

  return `<svg class="avatar" viewBox="0 0 200 200" width="${size}" height="${size}" role="img" aria-label="${a.name}">
